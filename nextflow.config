manifest {
    name = 'wnt-beta-catenin-rnaseq-analysis'
    author = 'Md Tariqul Islam'
    description = 'Auditable orthology-mapped Wnt/PCP functional-association workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    pipeline_script = "${projectDir}/scripts/wntpcp_funmap_pipeline.py"

    deseq = "${projectDir}/tests/fixtures/wntpcp/deseq_example.csv"
    orthology = "${projectDir}/tests/fixtures/wntpcp/orthology_example.csv"
    funmap = "${projectDir}/tests/fixtures/wntpcp/funmap_example.tsv"
    string_file = "${projectDir}/tests/fixtures/wntpcp/string_example.tsv"
    literature = "${projectDir}/tests/fixtures/wntpcp/literature_example.csv"
    gene_file = "${projectDir}/tests/fixtures/wntpcp/genes_example.txt"

    string_species = 'mouse'
    funmap_score_min = 0.50
    string_score_min = 0.70
    max_edges = 80
    seed = 101

    prefix = 'wntpcp_funmap_network'
    title = 'Synthetic Wnt/PCP workflow smoke test'
    outdir = "${projectDir}/results/nextflow_smoke"

    container_image = 'wnt-rnaseq-analysis:workflow'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0

    withName: WNTPCP_FUNMAP {
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    local {
        docker.enabled = false
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${projectDir}/results/nextflow_metadata/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${projectDir}/results/nextflow_metadata/report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${projectDir}/results/nextflow_metadata/trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${projectDir}/results/nextflow_metadata/dag.html"
}
